{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User accounts in the system (Admin, GiaoVu, GiangVien, SinhVien)",
      "properties": {
        "maNguoiDung": { "type": "string" },
        "username": { "type": "string" },
        "maDinhDanh": { "type": "string" },
        "hoTen": { "type": "string" },
        "email": { "type": "string" },
        "soDienThoai": { "type": "string" },
        "vaiTro": { "type": "string" },
        "trangThaiTaiKhoan": { "type": "string" },
        "quyenQuanLyNguoiDung": { "type": "boolean" },
        "tenKhoa": { "type": "string" },
        "tenBoMon": { "type": "string" },
        "lopSinhHoat": { "type": "string" }
      },
      "required": ["maNguoiDung", "username", "hoTen", "email", "vaiTro"]
    },
    "classes": {
      "title": "Classes",
      "description": "Internship classes assigned to teachers",
      "properties": {
        "maLopHP": { "type": "string" },
        "tenLopHP": { "type": "string" },
        "hocKy": { "type": "string" },
        "namHoc": { "type": "string" },
        "magv": { "type": "string" },
        "tenGiangVien": { "type": "string" },
        "soSinhVien": { "type": "number" },
        "soNhom": { "type": "number" }
      },
      "required": ["maLopHP", "tenLopHP"]
    },
    "cycles": {
      "title": "Cycles",
      "description": "Practicum / Internship cycles",
      "properties": {
        "maDot": { "type": "string" },
        "tenDot": { "type": "string" },
        "hocKy": { "type": "string" },
        "namHoc": { "type": "string" },
        "trangThai": { "type": "string" },
        "ngayBatDau": { "type": "string" },
        "ngayKetThuc": { "type": "string" }
      },
      "required": ["maDot", "tenDot"]
    },
    "requests": {
      "title": "Requests",
      "description": "Account requests submitted by teachers/students",
      "properties": {
        "maYeuCau": { "type": "string" },
        "nguoiYeuCau": { "type": "string" },
        "loaiYeuCau": { "type": "string" },
        "noiDung": { "type": "string" },
        "trangThai": { "type": "string" },
        "ngayTao": { "type": "string" }
      },
      "required": ["maYeuCau", "loaiYeuCau"]
    },
    "notifications": {
      "title": "Notifications",
      "description": "Real-time user notifications for topic approvals, diary feedback, and class announcements",
      "properties": {
        "userId": { "type": "string", "description": "Target user identifier (e.g. MSSV or student ID or all)" },
        "role": { "type": "string", "description": "Target role (SinhVien, GiangVien, etc.)" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "link": { "type": "string" }
      },
      "required": ["title", "message", "type", "read", "createdAt"]
    },
    "diaries": {
      "title": "Diaries",
      "description": "Weekly internship diary entries logged by students",
      "properties": {
        "userId": { "type": "string", "description": "Student unique identifier (MSSV e.g. 20241001, 20241021)" },
        "studentName": { "type": "string" },
        "week": { "type": "number" },
        "date": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string" },
        "images": { "type": "array" },
        "ratings": { "type": "object" },
        "feedback": { "type": "string" },
        "aiSummary": { "type": "string" }
      },
      "required": ["userId", "week", "content", "updatedAt"]
    },
    "topics": {
      "title": "Topics",
      "description": "Internship topic proposals submitted by students",
      "properties": {
        "userId": { "type": "string", "description": "Student unique identifier (MSSV e.g. 20241001)" },
        "mssv": { "type": "string" },
        "studentName": { "type": "string" },
        "class": { "type": "string" },
        "group": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "file": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "feedback": { "type": "string" },
        "isUnlockedEdit": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "title", "description", "status"]
    }
  },
  "firestore": {
    "users": {
      "schema": "users",
      "description": "Collection of system user accounts"
    },
    "classes": {
      "schema": "classes",
      "description": "Collection of academic classes"
    },
    "cycles": {
      "schema": "cycles",
      "description": "Collection of practicum cycles"
    },
    "requests": {
      "schema": "requests",
      "description": "Collection of account requests"
    },
    "notifications": {
      "schema": "notifications",
      "description": "Collection of user notifications"
    },
    "diaries": {
      "schema": "diaries",
      "description": "Collection of student internship diary records scoped by userId"
    },
    "topics": {
      "schema": "topics",
      "description": "Collection of internship topic proposals"
    }
  }
}
